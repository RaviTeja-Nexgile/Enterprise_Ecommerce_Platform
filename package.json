{
  "name": "e-commerce-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade e-commerce platform: Angular storefront and admin dashboard over a Flask API on SQLite.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "node scripts/install-all.js",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm test --workspace backend",
    "test:frontend": "npm test --workspace frontend",
    "dev": "node scripts/dev.js",
    "dev:api": "node scripts/dev-api.js",
    "dev:frontend": "npm run start --workspace frontend",
    "db:upgrade": "node scripts/db-upgrade.js",
    "db:seed": "node scripts/db-seed.js"
  },
  "engines": {
    "node": ">=20"
  }
}
