# Copy this file to .env and adjust the values for your machine.
# Every value below is read by backend/app/config.py; nothing here is a secret
# in local development, and no cloud service is used.

# Runtime mode: development | testing | production
FLASK_ENV=development
NODE_ENV=development

# Port the Angular dev server listens on (127.0.0.1:$PORT)
PORT=4200

# Port the Flask API listens on (127.0.0.1:$API_PORT)
API_PORT=5001

# SQLite database file, relative to the repository root
DATABASE_URL=sqlite:///backend/instance/ecommerce.db

# Secret used to sign access tokens (change it for anything but local use)
SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me

# Access token lifetime in minutes and refresh token lifetime in days
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Local development mail inbox (Mailpit)
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SENDER=no-reply@example.com
MAILPIT_UI_PORT=8025

# Where uploaded product images are stored and served from
UPLOAD_FOLDER=backend/uploads
MAX_UPLOAD_BYTES=5242880

# Storefront origin allowed by CORS in development
FRONTEND_ORIGIN=http://127.0.0.1:4200
